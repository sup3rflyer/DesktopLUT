// Resource file for DesktopLUT
#include <winver.h>
#include "resource.h"
#include "src/version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION DESKTOPLUT_VERSION_MAJOR,DESKTOPLUT_VERSION_MINOR,DESKTOPLUT_VERSION_PATCH,0
 PRODUCTVERSION DESKTOPLUT_VERSION_MAJOR,DESKTOPLUT_VERSION_MINOR,DESKTOPLUT_VERSION_PATCH,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "DesktopLUT"
            VALUE "FileDescription", "DesktopLUT"
            VALUE "FileVersion", DESKTOPLUT_VERSION_STR
            VALUE "InternalName", "DesktopLUT"
            VALUE "LegalCopyright", "GPL-3.0"
            VALUE "OriginalFilename", "DesktopLUT.exe"
            VALUE "ProductName", "DesktopLUT"
            VALUE "ProductVersion", DESKTOPLUT_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// Icon resource - ID 1 is the main application icon
IDI_APPICON ICON "DesktopLUT.ico"
IDI_APPICON_ACTIVE ICON "DesktopLUT-active.ico"

// The logo artwork (the interface header draws it; decoded with WIC at runtime)
IDR_LOGO_PNG RCDATA "DesktopLUT-logo.png"
