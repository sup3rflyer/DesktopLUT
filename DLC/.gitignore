# Python
__pycache__/
*.py[cod]

# Local calibration output
runs/*
!runs/.gitkeep
profiles/*
!profiles/.gitkeep
preflight/

# Private user data — the "skill ⊥ user-data separation" boundary.
# The agent/core is generic & shareable; THIS is yours and never leaves the box.
calibration_profile.yaml
# The persistent per-display correction store (CCMX/SPD/resolved-white record) —
# display- and probe-specific, lives next to the profile.
correction_store.json
# The persistent per-display+instrument profile (DIP): measured panel/meter behaviour
# (native white/primaries, noise model, cold channel, thermal regime) — same private,
# display-specific class as correction_store.json.
dip_store.json
results/
# Measurement & instrument-correction artifacts (display- and probe-specific)
*.ti1
*.ti3
*.sp
*.ccmx
*.ccss
# Scratch bring-up tooling (names the panel model / local paths — keep local)
_bringup_smoke.py
_live_measure_smoke.py

# requirements.txt is a real tracked file; the root-level "*.txt" rule (eeColor
# LUT data) would otherwise sweep it up. Re-include it.
!requirements.txt

# Contained third-party binaries are installed/copied locally.
third_party/argyll/
third_party/dogegen/
third_party/vendor_manifest.json

# Local/private operator and supervisor handoff notes
docs/calibration-handoff.md
docs/agent-tooling.md
# Internal R&D / handoff design docs (kept local until DLC is published-ready;
# some carry display-specific measurements). The public face is README + CHANGELOG.
docs/HANDOFF.md
docs/HANDOFF-archive-*.md
docs/v2-design-notes.md
docs/v1-rebuild-plan.md
docs/hdr-target-design.md
docs/audit-2026-06-17/
docs/audit-2026-06-19/
CLAUDE.md
.claude/

